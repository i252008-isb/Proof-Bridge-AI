# ProofBridge backend environment template.
#
# Copy this file to .env on a fresh checkout and replace every placeholder.
# If .env already exists, back it up and merge keys instead of overwriting.
# NEVER commit a real .env file, API key, PayPal secret, or JWT secret.
# The repository .gitignore already excludes .env, uploads/, and *.db.

# ---------------------------------------------------------------------------
# Core backend
# ---------------------------------------------------------------------------

APP_NAME=ProofBridge AI API
APP_VERSION=1.0.0

# SQLite (default). Relative paths resolve from the repository root.
DATABASE_URL=sqlite:///./proofbridge.db
# PostgreSQL example (install psycopg[binary] first; see requirements-prod.txt):
# DATABASE_URL=postgresql+psycopg://proofbridge:REPLACE_PASSWORD@127.0.0.1:5432/proofbridge

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Access-token lifetime in minutes. 1440 = 24 hours.
ACCESS_TOKEN_MINUTES=1440

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Comma-separated explicit origins. Do not use "*" with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Upload storage. Relative paths resolve from the repository root.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# PayPal read-only transaction and order lookup (optional)
# ---------------------------------------------------------------------------
# Leave blank to keep PayPal lookup disabled. The API exposes no create,
# capture, authorize, void, refund, payout, transfer, or release operation.
# Person 4's module called this base URL PAYPAL_BASE_URL; this backend reads
# PAYPAL_API_BASE instead.
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_SECONDS=15
FRONTEND_RETURN_URL=http://localhost:5173/payment/return
FRONTEND_CANCEL_URL=http://localhost:5173/payment/cancel

# ---------------------------------------------------------------------------
# Person 3 AI module (proofbridge_ai)
# ---------------------------------------------------------------------------
# Demo mode forces offline, deterministic mock providers. Keep it true for
# local development and automated tests. No external AI calls are made.
PROOFBRIDGE_ENV=development
PROOFBRIDGE_DEMO_MODE=true
PROOFBRIDGE_LOG_LEVEL=INFO

# LLM provider: mock or openai (any OpenAI-compatible API).
PROOFBRIDGE_LLM_PROVIDER=mock
PROOFBRIDGE_LLM_API_KEY=
PROOFBRIDGE_LLM_BASE_URL=https://api.openai.com/v1
PROOFBRIDGE_LLM_MODEL=gpt-4o-mini
PROOFBRIDGE_LLM_TEMPERATURE=0.0
PROOFBRIDGE_MAX_RETRIES=2
PROOFBRIDGE_HTTP_TIMEOUT_SECONDS=60

# Embeddings provider: mock or openai.
PROOFBRIDGE_EMBEDDINGS_PROVIDER=mock
PROOFBRIDGE_EMBEDDINGS_API_KEY=
PROOFBRIDGE_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
PROOFBRIDGE_EMBEDDING_MODEL=text-embedding-3-small

# Vision provider: mock or openai (multimodal model).
PROOFBRIDGE_VISION_PROVIDER=mock
PROOFBRIDGE_VISION_API_KEY=
PROOFBRIDGE_VISION_BASE_URL=https://api.openai.com/v1
PROOFBRIDGE_VISION_MODEL=gpt-4o-mini

# OCR requires the Tesseract engine and the optional pytesseract package.
PROOFBRIDGE_OCR_ENABLED=false
PROOFBRIDGE_TESSERACT_CMD=
PROOFBRIDGE_OCR_LANGUAGE=eng

# AI-side limits (separate from the backend MAX_UPLOAD_BYTES).
PROOFBRIDGE_MAX_FILE_SIZE_BYTES=10485760
PROOFBRIDGE_MAX_PDF_PAGES=100
PROOFBRIDGE_MAX_IMAGE_PIXELS=25000000
PROOFBRIDGE_MAX_DOCUMENT_CHARS=200000

# Similarity thresholds: supported must be >= partial.
PROOFBRIDGE_SIMILARITY_SUPPORTED_THRESHOLD=0.60
PROOFBRIDGE_SIMILARITY_PARTIAL_THRESHOLD=0.40
PROOFBRIDGE_SIMILARITY_MAX_CANDIDATES=5
